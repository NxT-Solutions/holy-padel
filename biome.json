{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!design", "!**/*.gen.ts", "!apps/mobile/targets"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "all",
      "reactNative": "all",
      "test": "all",
      "turborepo": "all",
      "project": "all",
      "types": "all",
      "drizzle": "none",
      "next": "none",
      "playwright": "none",
      "qwik": "none",
      "solid": "none",
      "svelte": "none",
      "tailwind": "none",
      "vue": "none"
    },
    "rules": {
      "preset": "all",
      "nursery": "on",
      "complexity": {
        "noVoid": "off"
      },
      "style": {
        "noTernary": "off",
        "useExportsLast": "off",
        "useNamingConvention": {
          "level": "error",
          "options": {
            "conventions": [
              {
                "selector": {
                  "kind": "objectLiteralProperty"
                },
                "formats": ["camelCase", "CONSTANT_CASE"]
              },
              {
                "selector": {
                  "kind": "typeProperty"
                },
                "formats": ["camelCase", "CONSTANT_CASE"]
              }
            ],
            "strictCase": false
          }
        }
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.config.ts", "**/*.config.js", "**/app/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["**/metro.config.js", "**/babel.config.js"],
      "linter": {
        "rules": {
          "style": {
            "noCommonJs": "off"
          },
          "correctness": {
            "noGlobalDirnameFilename": "off"
          }
        }
      }
    },
    {
      "includes": ["**/src/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": ["**/test/**", "**/e2e/**"],
      "linter": {
        "rules": {
          "style": {
            "noMagicNumbers": "off"
          },
          "performance": {
            "useTopLevelRegex": "off",
            "noAwaitInLoops": "off"
          },
          "nursery": {
            "useConsistentTestIt": "off",
            "noConditionalExpect": "off"
          },
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": {
              "level": "error",
              "options": {
                "maxLines": 220
              }
            },
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 20
              }
            }
          },
          "style": {
            "noMagicNumbers": "off",
            "useComponentExportOnlyModules": "off",
            "noJsxLiterals": "off",
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 500
              }
            }
          },
          "performance": {
            "noJsxPropsBind": "off"
          },
          "nursery": {
            "useExplicitType": "off",
            "useExplicitReturnType": "off",
            "noReactNativeRawText": {
              "level": "error",
              "options": {
                "skip": ["Display", "Body", "Overline"]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/e2e/**", "**/playwright.config.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          },
          "style": {
            "noProcessEnv": "off",
            "useNamingConvention": "off"
          }
        }
      }
    }
  ]
}
